{
  "id": "skill-commit",
  "name": "Commit skill",
  "description": "Runs the claude-commit-skill installer (github.com/elvisgastelum/claude-commit-skill): a title-only Conventional Commit skill, a commit-guard PreToolUse hook that blocks AI attribution, the attribution/includeCoAuthoredBy settings and a managed CLAUDE.md block. Needs bash, curl and jq.",
  "tags": ["skills", "git", "installer"],
  "provides": {
    "paths": ["skills/commit", "hooks/commit-guard.sh"],
    "settings": ["/attribution", "/includeCoAuthoredBy"],
    "hooks": ["hooks/commit-guard.sh"],
    "claudeMdBlocks": ["claude-commit-skill"]
  },
  "steps": [
    {
      "type": "command",
      "shell": "curl -fsSL https://raw.githubusercontent.com/elvisgastelum/claude-commit-skill/main/install.sh | bash",
      "env": {
        "CLAUDE_DIR": "${CCC_CLAUDE_DIR}"
      },
      "checkShell": "test -f \"$CCC_CLAUDE_DIR/skills/commit/SKILL.md\" && test -f \"$CCC_CLAUDE_DIR/hooks/commit-guard.sh\" && grep -q 'BEGIN claude-commit-skill' \"$CCC_CLAUDE_DIR/CLAUDE.md\"",
      "requiresBin": "curl"
    }
  ]
}
