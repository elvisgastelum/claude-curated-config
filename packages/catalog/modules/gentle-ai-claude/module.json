{
  "id": "gentle-ai-claude",
  "name": "gentle-ai for Claude Code",
  "description": "Runs `gentle-ai install --agent claude-code --scope global --preset full-gentleman` once (skipped when ~/.gentle-ai/state.json lists claude-code in installed_agents): SDD/review/judgment-day agents, gentle-sdd commands, its skills, the gentleman theme and output style, the engram MCP server, its permission deny rules, its settings hooks and managed CLAUDE.md sections. Writes to ~/.claude and ~/.claude.json. Run `gentle-ai sync` later to update. Needs jq.",
  "tags": ["gentle-ai", "agents", "skills", "installer"],
  "requires": ["tool-gentle-ai"],
  "provides": {
    "paths": [
      "agents/sdd-*.md",
      "agents/jd-*.md",
      "agents/review-*.md",
      "agents/.gentle-ai-native-agent-ownership.json",
      "commands/gentle-sdd-*.md",
      "commands/sdd-*.md",
      "mcp/context7.json",
      "mcp/engram.json",
      "output-styles/gentleman.md",
      "themes/gentleman*.json",
      "skills/_shared",
      "skills/sdd-*",
      "skills/branch-pr",
      "skills/chained-pr",
      "skills/cognitive-doc-design",
      "skills/comment-writer",
      "skills/gentle-ai-bench",
      "skills/go-testing",
      "skills/issue-creation",
      "skills/judgment-day",
      "skills/rdd-defect-workflow",
      "skills/skill-creator",
      "skills/skill-improver",
      "skills/skill-registry",
      "skills/systemic-issue-triage",
      "skills/work-unit-commits"
    ],
    "settings": [
      "/theme",
      {
        "pointer": "/permissions/deny",
        "items": [
          "Bash(rm -rf /)",
          "Bash(sudo rm -rf /)",
          "Bash(rm -rf ~)",
          "Bash(sudo rm -rf ~)",
          "Read(.env)",
          "Read(.env.*)",
          "Edit(.env)",
          "Edit(.env.*)",
          "Read(.ssh/*)",
          "Edit(.ssh/*)",
          "Read(.credentials/*)",
          "Edit(.credentials/*)",
          "Read(Library/Keychains/*)",
          "Edit(Library/Keychains/*)",
          "Read(.aws/credentials)",
          "Edit(.aws/credentials)",
          "Read(.config/gh/hosts.yml)",
          "Edit(.config/gh/hosts.yml)",
          "Read(**/*.pem)",
          "Edit(**/*.pem)",
          "Read(**/*.key)",
          "Edit(**/*.key)",
          "Read(**/secrets/*)",
          "Edit(**/secrets/*)"
        ]
      }
    ],
    "hooks": ["gentle-ai "],
    "claudeMdBlocks": ["gentle-ai:*"],
    "mcpServers": ["engram"]
  },
  "steps": [
    {
      "type": "command",
      "run": [
        "gentle-ai",
        "install",
        "--agent",
        "claude-code",
        "--scope",
        "global",
        "--preset",
        "full-gentleman"
      ],
      "checkShell": "jq -e '(.installed_agents // []) | index(\"claude-code\") != null' \"$HOME/.gentle-ai/state.json\" >/dev/null 2>&1",
      "requiresBin": ["gentle-ai", "jq"],
      "globalOnly": true
    }
  ]
}
