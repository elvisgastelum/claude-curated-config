{
  "id": "skill-continue",
  "name": "Continue skill",
  "description": "Runs the claude-continue-skill installer (github.com/elvisgastelum/claude-continue-skill): adds the continue skill. Needs bash and curl.",
  "tags": ["skills", "installer"],
  "provides": {
    "paths": ["skills/continue"]
  },
  "steps": [
    {
      "type": "command",
      "shell": "curl -fsSL https://raw.githubusercontent.com/elvisgastelum/claude-continue-skill/main/install.sh | bash",
      "env": {
        "CLAUDE_DIR": "${CCC_CLAUDE_DIR}"
      },
      "checkShell": "test -f \"$CCC_CLAUDE_DIR/skills/continue/SKILL.md\"",
      "requiresBin": "curl"
    }
  ]
}
