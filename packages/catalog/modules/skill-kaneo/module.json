{
  "id": "skill-kaneo",
  "name": "Kaneo work tracking skill",
  "description": "Runs the kaneo-work-tracking-skill installer: the kaneo-work-tracking skill, a managed CLAUDE.md block and the kaneo HTTP MCP server in .claude.json. Uses $KANEO_URL (default https://kaneo.example.com). Needs bash, curl and jq.",
  "tags": ["skills", "kaneo", "mcp", "installer"],
  "provides": {
    "paths": ["skills/kaneo-work-tracking"],
    "claudeMdBlocks": ["kaneo-work-tracking-skill"],
    "mcpServers": ["kaneo"]
  },
  "steps": [
    {
      "type": "command",
      "shell": "curl -fsSL https://raw.githubusercontent.com/elvisgastelum/kaneo-work-tracking-skill/main/install.sh | bash",
      "env": {
        "CLAUDE_DIR": "${CCC_CLAUDE_DIR}",
        "CLAUDE_JSON": "${CCC_CLAUDE_JSON}",
        "KANEO_URL": "${KANEO_URL:-https://kaneo.example.com}"
      },
      "checkShell": "test -f \"$CCC_CLAUDE_DIR/skills/kaneo-work-tracking/SKILL.md\" && grep -q '\"kaneo\"' \"$CCC_CLAUDE_JSON\"",
      "requiresBin": "curl"
    }
  ]
}
